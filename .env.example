# Optional. The settings page stores what the app actually uses.
# Any OpenAI-compatible vision API. These defaults are DeepSeek.
ONLINE_API_KEY=
ONLINE_BASE_URL=https://api.deepseek.com
ONLINE_MODEL=deepseek-flash

# LM Studio local server. Include the /v1 prefix.
# Start it from LM Studio: Developer, then Start server. Load a vision model first.
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=
LOCAL_API_KEY=
